# ---------- پیکربندی بک‌اند Django فروشگاه خانم گل ----------
# این فایل را به «.env.» کپی کنید و مقادیر را پر کنید (یا در پنل هاست متغیر محیطی بسازید).
# هرگز .env واقعی را در گیت کامیت نکنید.

# ---------- سرور ----------
DEBUG=false
# دامنه‌های مجاز (با کاما) — در تولید حتماً تنظیم کنید
ALLOWED_HOSTS=*
# راز امضای توکن‌ها؛ اگر خالی باشد خودکار ساخته و در backend/.env ذخیره می‌شود
SECRET_KEY=
# عمر توکن ورود (روز)
TOKEN_TTL_DAYS=30

# ---------- پایگاه داده ----------
# هاست cPanel: DB_ENGINE=mysql و مقادیر دیتابیس ساخته‌شده در
# cPanel → «MySQL® Databases» (نام دیتابیس و کاربر پیشوند حساب می‌گیرند،
# مثل khanomgo_foodshop و khanomgo_shop). مجموعه‌کاراکتر: utf8mb4.
# توسعهٔ محلی: DB_ENGINE حذف یا sqlite3 → SQLite در backend/db.sqlite3
DB_ENGINE=mysql
DB_NAME=khanomgo_foodshop
DB_USER=khanomgo_shop
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ---------- زیرمسیر Passenger (Application URL) ----------
# الگوی این پروژه: برنامه در cPanel → Setup Python App با Application URL
# = /food-shop سرو می‌شود؛ این دو مقدار برای درست کار کردن لینک‌ها و CSS
# پنل ادمین جنگو لازم‌اند. اگر برنامه را روی مسیر دیگری سرو می‌کنید، هر دو
# را با همان مسیر هم‌اهنگ کنید (اگر روی دامنهٔ جدا است، هر دو را خالی/حذف کنید).
FORCE_SCRIPT_NAME=/food-shop
STATIC_URL=/food-shop/static/

# ---------- امنیت TLS (بعد از فعال‌شدن https روی هاست) ----------
# ریدایرکت http→https و HSTS — فقط پس از اطمینان از کارکرد SSL روشن کنید
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
# اگر https واقعی از هدر X-Forwarded-Proto می‌آید (پشت پروکسی/لودبالانسر): true
SECURE_PROXY_SSL_HEADER=false
# دامنه‌های مورد اعتماد CSRF برای فرم‌های پنل ادمین جنگو (با کاما)؛ مثال:
# CSRF_TRUSTED_ORIGINS=https://shop.example.ir
CSRF_TRUSTED_ORIGINS=

# ---------- CORS (دامنهٔ فرانت) ----------
# برای GitHub Pages: https://hmplus28.github.io
# با کاما جدا کنید؛ * فقط برای تست
CORS_ORIGINS=*

# ---------- حساب مدیر پنل ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
ADMIN_PHONE=09120000000

# ---------- فروشگاه ----------
SHOP_NAME=فروشگاه خانم گل
SHOP_URL=https://hmplus28.github.io/food-shop/
# موبایل مدیر برای پیامک «سفارش جدید» (خالی = ارسال نشود)
SHOP_NOTIFY_PHONE=
# پیامک تأیید سفارش به خود مشتری هم برود؟ true/false
SMS_ORDER_TO_CUSTOMER=true
# پیامک تغییر وضعیت سفارش به مشتری برود؟ true/false
SMS_STATUS_TO_CUSTOMER=true

# ---------- پنل پیامک ----------
# console = حالت توسعه (پیامک واقعی نمی‌رود، فقط ثبت می‌شود)
# kavenegar | smsir | ghasedak | melipayamak
SMS_PROVIDER=console
# شمارهٔ خط ارسال خدماتی (برای melipayamak = شمارهٔ خط پنل)
SMS_SENDER=

# --- کاوه‌نگار: کلید API از kavenegar.com → تنظیمات → API Key ---
KAVENEGAR_API_KEY=
# نام قالب Verify برای کد یکبار مصرف (پنل → تنضیمات → قالب‌های تایید)؛ پارامتر {token}
KAVENEGAR_OTP_TEMPLATE=

# --- SMS.ir: کلید API از پنل sms.ir → امنیت → کلیدهای API ---
SMSIR_API_KEY=
# شناسهٔ عددی قالب کد یکبار مصرف (پنل → توسعه‌دهندگان → قالب‌ها)؛ پارامتر قالب باید CODE باشد
SMSIR_OTP_TEMPLATE_ID=
SMSIR_LINE=

# --- قاصدک: apikey از پنل ghasedak.me ---
GHASEDAK_API_KEY=
GHASEDAK_OTP_TEMPLATE=
GHASEDAK_LINE=

# --- ملی پیامک: حساب پنل payamak-panel.com ---
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=

# ---------- محدودیت‌های کد یکبار مصرف ----------
OTP_TTL=120          # اعتبار کد (ثانیه)
OTP_COOLDOWN=90      # فاصلهٔ حداقلی دو ارسال (ثانیه)
OTP_HOURLY=5         # حداکثر ارسال در ساعت برای هر شماره
OTP_MAX_ATTEMPTS=5   # حداکثر تلاش ورود کد غلط
