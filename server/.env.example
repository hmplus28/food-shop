# ---------- پیکربندی بک‌اند فروشگاه خانم گل ----------
# این فایل را به «.env.» کپی کنید (یا در پنل هاست متغیرهای محیطی بسازید) و مقادیر را پر کنید.
# هرگز .env واقعی را در گیت کامیت نکنید.

# ---------- سرور ----------
PORT=8787
# مبداهای مجاز CORS (با کاما جدا کنید؛ * یعنی همه — فقط برای تست)
CORS_ORIGINS=*
# راز امضای توکن JWT (حتماً عوض کنید؛ اگر خالی باشد خودکار ساخته و در db ذخیره می‌شود)
JWT_SECRET=
# عمر توکن (روز)
TOKEN_TTL_DAYS=30

# ---------- حساب مدیر (برای ورود به پنل مدیریت سمت سرور) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# ---------- فروشگاه ----------
SHOP_NAME=فروشگاه خانم گل
SHOP_URL=https://hmplus28.github.io/food-shop/
# شماره‌ای که پیامک سفارش جدید به آن می‌رود (موبایل مدیر فروشگاه)
SHOP_NOTIFY_PHONE=
# پیامک تأیید سفارش به خود مشتری هم ارسال شود؟ (true/false)
SMS_ORDER_TO_CUSTOMER=true
# پیامک تغییر وضعیت سفارش به مشتری ارسال شود؟ (true/false)
SMS_STATUS_TO_CUSTOMER=true

# ---------- پنل پیامک ----------
# مقادیر مجاز: console | kavenegar | smsir | ghasedak | melipayamak
# console = حالت توسعه؛ پیامک‌ها فقط در لاگ سرور و پنل مدیر ثبت می‌شوند.
SMS_PROVIDER=console

# شماره خط ارسال (پیش‌شماره خدماتی، مثلاً 10008663 یا 5000…). برای melipayamak همان شماره خط پنل.
SMS_SENDER=

# --- کاوه‌نگار (api-key از پنل kavenegar.com → تنظیمات → کلید API) ---
KAVENEGAR_API_KEY=
# نام قالب Verify (Lookup) برای کد یکبار مصرف؛ در پنل کاوه‌نگار بسازید (مثلاً khanomgol-otp)
KAVENEGAR_OTP_TEMPLATE=

# --- SMS.ir (کلید API از پنل sms.ir → امنیت → کلیدهای API) ---
SMSIR_API_KEY=
# شناسه عددی قالب برای کد یکبار مصرف (پنل SMS.ir → توسعه‌دهندگان → قالب‌ها)؛ پارامتر قالب باید CODE باشد
SMSIR_OTP_TEMPLATE_ID=
SMSIR_LINE=

# --- قاصدک (apikey از پنل ghasedak.me) ---
GHASEDAK_API_KEY=
GHASEDAK_OTP_TEMPLATE=
GHASEDAK_LINE=

# --- ملی پیامک (نام کاربری/رمز پنل payamak-panel.com و شماره خط) ---
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=

# ---------- محدودیت‌های کد یکبار مصرف (ثانیه/تعداد) ----------
OTP_TTL=120
OTP_COOLDOWN=90
OTP_HOURLY=5
OTP_MAX_ATTEMPTS=5
