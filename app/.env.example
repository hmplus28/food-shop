# فروشگاه خانم گل — نمونهٔ تنظیمات محیط
# کپی کنید به ‎.env‎ و مقادیر را ویرایش کنید:   cp .env.example .env
# همهٔ مقادیرِ VITE_* در زمان build داخل باندل می‌روند (بعد از build تغییرشان بی‌اثر است).

# ── مسیر پایهٔ انتشار ──
# GitHub Pages: /food-shop/   |   cPanel / دامنهٔ اختصاصی: /
# توجه: vite.config.js فقط مقدارِ محیطیِ شل (export VITE_BASE=…) را برای
# تعیین base می‌خواند؛ اسکریپت deploy/deploy_cpanel.sh این را خودکار می‌کند.
VITE_BASE=/food-shop/

# ── آدرس سایت برای سئو (canonical، sitemap، robots، JSON-LD، ترب) ──
# آدرس کامل ریشهٔ سایت بدون اسلش آخر؛ روی دامنهٔ واقعی حتماً تنظیم کنید:
#   دامنه در ریشه:   VITE_SITE_URL=https://shop.example.ir   (VITE_BASE=/)
#   زیرمسیر:         VITE_SITE_URL=https://example.ir/food-shop (VITE_BASE=/food-shop/)
# خالی = GitHub Pages (https://hmplus28.github.io/food-shop)
VITE_SITE_URL=

# ── اتصال به بک‌اند REST ──
# false = فروشگاه فقط با دادهٔ محلی کار می‌کند (رفتار GitHub Pages)
# true  = محصولات/سفارش‌ها/ورود به آدرس VITE_API_BASE وصل می‌شوند؛
#         در خطای شبکه بی‌صدا به دادهٔ محلی برمی‌گردند.
VITE_API_ENABLED=false
VITE_API_BASE=https://api.example.ir/api/v1
VITE_API_TIMEOUT=6000

# قرارداد نقاط پایانی انتظارِ اپ (پاسخ JSON):
#   GET   {BASE}/products         → آرایهٔ محصولات یا {results|data:[…]}
#   POST  {BASE}/orders           → {code, status?}
#   GET   {BASE}/orders/{code}    → {code, status}
#   PATCH {BASE}/orders/{code}    → {code, status}
#   POST  {BASE}/auth/register    → {ok, user?, token?}
#   POST  {BASE}/auth/login       → {ok, user?, token?}
#   GET   {BASE}/health           → پاسخ 2xx
